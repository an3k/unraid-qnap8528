<FILE Name="&emhttp;/README.md">
<INLINE>
**QNAP8528**

This package contains and installs the QNAP IT8528 Embedded Controller Kernel module, this allows you to read fan speeds and temperatures as well as reading and writing the fan PWM values from the ITE Tech Inc. IT8528 embedded controller chip.  
Currently known supported units are listed in the upstream repository: [Supported Models](https://github.com/0xGiddi/qnap8528#supported-models)

Source: https://github.com/0xGiddi/qnap8528
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>

download() {
# Download QNAP8528 package
if wget -q -nc --show-progress --progress=bar:force:noscroll -O "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}" "${DL_URL}/${LAT_PACKAGE}" ; then
  wget -q -nc --show-progress --progress=bar:force:noscroll -O "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}.md5" "${DL_URL}/${LAT_PACKAGE}.md5"
  if [ "$(md5sum &packages;/${KERNEL_V%%-*}/${LAT_PACKAGE} | awk '{print $1}')" != "$(cat &packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}.md5 | awk '{print $1}')" ]; then
    echo
    echo "---CHECKSUM ERROR!---"
    rm -rf &plugin; &emhttp;
    exit 1
  fi
  echo
  echo "-------------------Sucessfully downloaded QNAP8528 package-------------------"
else
  echo
  echo "-----------------------Can't download QNAP8528 package-----------------------"
  rm -rf &plugin; &emhttp;
  exit 1
fi
}

check() {
if ! ls -1 &packages;/${KERNEL_V%%-*}/ | grep -q "${PACKAGE}" ; then
  LAT_PACKAGE="$(wget -qO- https://api.github.com/repos/an3k/unraid-qnap8528/releases/tags/${KERNEL_V} | jq -r '.assets[].name' | grep "${PACKAGE}" | grep -E -v '\.md5$' | sort -V | tail -1)"
  echo
  echo "-----------------------Downloading QNAP8528 package!-------------------------"
  echo "--------This could take some time, please don't close this window!----------"
  download
else
  echo
  echo "-----------------------QNAP8528 package found locally------------------------"
fi
}

install() {
# Install QNAP8528 package
/sbin/installpkg "&packages;/${KERNEL_V%%-*}/${PACKAGE}*.txz" 2&gt;/dev/null
depmod -a 2&gt;/dev/null
}

activate() {
# Modprobe module
/sbin/modprobe qnap8528 || echo "-Error loading module, please post your Diagnostics on the support thread!-"
}

# Define Variables
KERNEL_V="$(uname -r)"
PACKAGE="qnap8528"
DL_URL="https://github.com/an3k/unraid-qnap8528/releases/download/$KERNEL_V"

if [ ! -d "&packages;/${KERNEL_V%%-*}" ]; then
  mkdir -p "&packages;/${KERNEL_V%%-*}"
fi

# Check for old packages
rm -rf $(ls -d &packages;/* | grep -v "${KERNEL_V%%-*}")

# Check if QNAP8528 package is already downloaded and installed
check
if ! modinfo qnap8528 -0 >/dev/null 2&gt;&amp;1 ; then
  install
  activate
else
  activate
fi

echo
echo "---------------Installation of QNAP8528 package successful-------------------"
echo

</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>

echo "--------------------------"
echo "---Uninstalling QNAP8528---"
echo "--------------------------"
# Remove plugin related files
rm -rf &emhttp;
rm -rf &plugin;
echo
echo "-----------------------------------------------------"
echo "---QNAP8528 uninstalled, please reboot your server!---"
echo "-----------------------------------------------------"
echo

</INLINE>
</FILE>
</PLUGIN>
