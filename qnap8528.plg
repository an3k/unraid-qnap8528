<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "qnap8528">
  <!ENTITY author    "an3k">
  <!ENTITY version   "2026.10.02">
  <!ENTITY gitURL    "https://github.com/&author;/unraid-qnap8528/raw/master">
  <!ENTITY pluginURL "&gitURL;/&name;.plg">
  <!ENTITY plugin    "/boot/config/plugins/&name;">
  <!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
  <!ENTITY packages  "/boot/config/plugins/&name;/packages">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" min="7.3.2" support="https://github.com/&author;/unraid-qnap8528/issues">

<CHANGES>

###2026.10.02
- Initial Unraid packaging for 0xGiddi/qnap8528
- Initial package built for Unraid 7.3.2 / 6.18.38-Unraid

</CHANGES>

<FILE Name="&emhttp;/README.md">
<INLINE>
**QNAP8528**

Unraid package for the qnap8528 kernel driver by 0xGiddi.

The driver exposes supported QNAP IT8528 embedded-controller functions through standard Linux subsystems, including hwmon fan/temperature reporting and PWM control.

Upstream source: https://github.com/0xGiddi/qnap8528
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>

download() {
  if wget -q -nc --show-progress --progress=bar:force:noscroll \
      -O "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}" \
      "${DL_URL}/${LAT_PACKAGE}" ; then

    wget -q -nc \
      -O "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}.md5" \
      "${DL_URL}/${LAT_PACKAGE}.md5"

    if [ "$(md5sum "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}" | awk '{print $1}')" != \
         "$(awk '{print $1}' "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}.md5")" ]; then
      echo
      echo "---------------------------CHECKSUM ERROR!---------------------------"
      rm -rf "&plugin;" "&emhttp;"
      exit 1
    fi

    echo
    echo "----------------Successfully downloaded QNAP8528 package-------------"
  else
    echo
    echo "--------------------Can't download QNAP8528 package-------------------"
    rm -rf "&plugin;" "&emhttp;"
    exit 1
  fi
}

check() {
  if ! ls -1 "&packages;/${KERNEL_V%%-*}/" 2>/dev/null | grep -q "${PACKAGE}" ; then
    LAT_PACKAGE="$(
      wget -qO- "https://api.github.com/repos/&author;/unraid-qnap8528/releases/tags/${KERNEL_V}" \
      | jq -r '.assets[].name' \
      | grep "${PACKAGE}" \
      | grep -E -v '\.md5$' \
      | sort -V \
      | tail -1
    )"

    if [ -z "${LAT_PACKAGE}" ]; then
      echo
      echo "No QNAP8528 package found for kernel ${KERNEL_V}."
      exit 1
    fi

    echo
    echo "--------------------Downloading QNAP8528 package----------------------"
    download
  else
    echo
    echo "--------------------QNAP8528 package found locally--------------------"
  fi
}

install() {
  /sbin/installpkg "&packages;/${KERNEL_V%%-*}/${PACKAGE}"*.txz 2>/dev/null
  /sbin/depmod -a 2>/dev/null
}

activate() {
  /sbin/modprobe qnap8528 || \
    echo "-Error loading qnap8528; check Diagnostics/dmesg-"
}

KERNEL_V="$(uname -r)"
PACKAGE="qnap8528"
DL_URL="https://github.com/&author;/unraid-qnap8528/releases/download/${KERNEL_V}"

mkdir -p "&packages;/${KERNEL_V%%-*}"

rm -rf $(ls -d "&packages;"/* 2>/dev/null | grep -v "${KERNEL_V%%-*}")

check

if ! modinfo qnap8528 -0 >/dev/null 2>&1 ; then
  install
  activate
else
  activate
fi

echo
echo "----------------Installation of QNAP8528 package successful-----------"
echo

</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>

echo "-------------------------"
echo "---Uninstalling QNAP8528-"
echo "-------------------------"

rm -rf "&emhttp;"
rm -rf "&plugin;"

echo
echo "--------------------------------------------------------"
echo "---QNAP8528 uninstalled, please reboot your server!---"
echo "--------------------------------------------------------"
echo

</INLINE>
</FILE>
</PLUGIN>
