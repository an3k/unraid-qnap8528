<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "qnap8528">
  <!ENTITY author    "an3k">
  <!ENTITY version   "2026.10.02">
  <!ENTITY gitURL    "https://github.com/&author;/unraid-qnap8528/raw/master">
  <!ENTITY pluginURL "&gitURL;/&name;.plg">
  <!ENTITY plugin    "/boot/config/plugins/&name;">
  <!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
  <!ENTITY packages  "/boot/config/plugins/&name;/packages">
]>

<PLUGIN  name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" min="6.10.2" support="https://github.com/&author;/unraid-qnap8528/issues">

<CHANGES>

###2026.10.02
- Initial release
- qnap8528 v1.24b package for Unraid Kernel 6.18.38-Unraid

</CHANGES>

<FILE Name="&emhttp;/README.md">
<INLINE>
**QNAP8528**

This package contains and installs the qnap8528 Kernel module, this allows you to read fan speeds and temperatures as well as reading and writing the fan PWM values from the ITE Tech Inc. IT8528 embedded controller chip.  
Currently known supported units are listed in the upstream repository: [Supported Models](https://github.com/0xGiddi/qnap8528#supported-models)

Source: https://github.com/0xGiddi/qnap8528
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>

download() {
# Download QNAP8528 package
if wget -q -nc --show-progress --progress=bar:force:noscroll -O "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}" "${DL_URL}/${LAT_PACKAGE}" ; then
  if ! wget -q -nc --show-progress --progress=bar:force:noscroll -O "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}.md5" "${DL_URL}/${LAT_PACKAGE}.md5" ; then
    echo
    echo "--------------------Can't download QNAP8528 checksum-----------------------"
    rm -rf &plugin; &emhttp;
    exit 1
  fi
  if [ "$(md5sum &packages;/${KERNEL_V%%-*}/${LAT_PACKAGE} | awk '{print $1}')" != "$(cat &packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}.md5 | awk '{print $1}')" ]; then
    echo
    echo "---CHECKSUM ERROR!---"
    rm -rf &plugin; &emhttp;
    exit 1
  fi
  echo
  echo "-------------------Sucessfully downloaded QNAP8528 package-------------------"
else
  echo
  echo "-----------------------Can't download QNAP8528 package-----------------------"
  rm -rf &plugin; &emhttp;
  exit 1
fi
}

check() {
LAT_PACKAGE="$(wget -qO- https://api.github.com/repos/an3k/unraid-qnap8528/releases/tags/${KERNEL_V} | jq -r '.assets[].name' 2&gt;/dev/null | grep "^${PACKAGE}-" | grep -E '\.txz$' | sort -V | tail -1)"
if [ -z "${LAT_PACKAGE}" ]; then
  echo
  echo "----------------No QNAP8528 package found for this Kernel-------------------"
  rm -rf &plugin; &emhttp;
  exit 1
fi
if [ ! -f "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}" ] || [ ! -f "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}.md5" ] || [ "$(md5sum &packages;/${KERNEL_V%%-*}/${LAT_PACKAGE} | awk '{print $1}')" != "$(cat &packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}.md5 2&gt;/dev/null | awk '{print $1}')" ]; then
  rm -f "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}" "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}.md5"
  echo
  echo "-----------------------Downloading QNAP8528 package!-------------------------"
  echo "--------This could take some time, please don't close this window!----------"
  download
else
  echo
  echo "-----------------------QNAP8528 package found locally------------------------"
fi
}

install() {
# Install QNAP8528 package
if ! /sbin/installpkg "&packages;/${KERNEL_V%%-*}/${LAT_PACKAGE}" 2&gt;/dev/null ; then
  echo
  echo "-----------------------Can't install QNAP8528 package------------------------"
  exit 1
fi
if ! depmod -a 2&gt;/dev/null ; then
  echo
  echo "------------------------------depmod failed----------------------------------"
  exit 1
fi
}

activate() {
# Modprobe module
if ! /sbin/modprobe qnap8528 ; then
  echo "-Error loading module, please post your Diagnostics at https://github.com/an3k/unraid-qnap8528/issues!-"
  exit 1
fi
}

# Define Variables
KERNEL_V="$(uname -r)"
PACKAGE="qnap8528"
DL_URL="https://github.com/an3k/unraid-qnap8528/releases/download/$KERNEL_V"

if [ ! -d "&packages;/${KERNEL_V%%-*}" ]; then
  mkdir -p "&packages;/${KERNEL_V%%-*}"
fi

# Check for old packages
rm -rf $(ls -d &packages;/* | grep -v "${KERNEL_V%%-*}")

# Check if QNAP8528 package is already downloaded and installed
check
if ! modinfo qnap8528 -0 >/dev/null 2&gt;&amp;1 ; then
  install
  activate
else
  activate
fi

echo
echo "---------------Installation of QNAP8528 package successful-------------------"
echo

</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>

echo "--------------------------"
echo "---Uninstalling QNAP8528---"
echo "--------------------------"
# Remove plugin related files
rm -rf &emhttp;
rm -rf &plugin;
echo
echo "-----------------------------------------------------"
echo "---QNAP8528 uninstalled, please reboot your server!---"
echo "-----------------------------------------------------"
echo

</INLINE>
</FILE>
</PLUGIN>
